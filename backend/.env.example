# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://quantumiq:quantumiq@db:5432/quantumiq
SECRET_KEY=your-secret-key-change-in-production
OPENAI_API_KEY=your-openai-api-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated. In production set this to your Vercel domain, e.g.
# CORS_ORIGINS=https://quantumiq.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Lets Vercel preview deployments (*.vercel.app) call the API. Set to false to
# pin origins exactly.
ALLOW_VERCEL_PREVIEWS=true

# ─── Public demo tutor ───────────────────────────────────────────────────────
# Every value here bounds what an anonymous visitor can spend of your OpenAI
# credit. Defaults are sized for a portfolio deployment on free tiers.
DEMO_ENABLED=true

# gpt-4o-mini, not gpt-4o — the demo is a single-shot completion, not the full
# agent loop, and costs roughly 1/25th as much per message.
DEMO_MODEL=gpt-4o-mini

DEMO_SESSION_LIMIT=5
DEMO_IP_LIMIT=15
DEMO_IP_WINDOW_SECONDS=3600
DEMO_IP_BURST_LIMIT=6
DEMO_IP_BURST_WINDOW_SECONDS=60

# Global ceiling across all visitors, resets at midnight UTC. At ~$0.0003 per
# demo message this caps spend near $0.09/day.
DEMO_DAILY_BUDGET=300

DEMO_MAX_MESSAGE_CHARS=500
DEMO_MAX_OUTPUT_TOKENS=400
DEMO_HISTORY_TURNS=6

# Shown to visitors who hit the demo limit.
DEMO_REPO_URL=https://github.com/ishaan2947/QuantumIQ

# Read the client IP from X-Forwarded-For. Correct behind Render/Vercel/any
# reverse proxy. Set to false only if the app is directly internet-facing,
# where the header could be spoofed to dodge the IP limiter.
TRUST_PROXY_HEADERS=true

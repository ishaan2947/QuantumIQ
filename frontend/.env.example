# Browser-facing origin of the FastAPI backend.
#
# Leave this UNSET for local development: vite.config.ts proxies /api to
# localhost:8000, so a relative path works and there is no CORS involved.
#
# Set it in the Vercel project's Environment Variables to the Render URL:
#   VITE_PUBLIC_API_URL=https://quantumiq-api.onrender.com
#
# Not to be confused with VITE_API_URL, which docker-compose sets to the
# Docker-network hostname used by the dev server's proxy.
VITE_PUBLIC_API_URL=

# Linked from the hero, the footer, and the demo-limit message.
VITE_GITHUB_REPO_URL=https://github.com/ishaan2947/QuantumIQ
